{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "food-9a095",
          "appId": "1:267091699106:android:e2d87ebe40382e9d9d3efb",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "food-9a095",
          "configurations": {
            "android": "1:267091699106:android:e2d87ebe40382e9d9d3efb",
            "ios": "1:267091699106:ios:0af3dd28b9282d959d3efb",
            "web": "1:267091699106:web:db4f3e4fe365ab8a9d3efb"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
        ]
      },
      {
        "source": "**/*.@(js|css|wasm)",
        "headers": [
          {"key": "Cache-Control", "value": "no-cache, must-revalidate"}
        ]
      }
    ],
    "rewrites": [
      {"source": "**", "destination": "/index.html"}
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
